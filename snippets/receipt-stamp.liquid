{% doc %}
  Receipt Stamp

  Renders a rubber-stamp style badge for receipt-themed buy box.
  Styled to look like an ink stamp rotated slightly with rough edges.

  @param {string} text - Stamp text content (e.g. "SAVE 20%")
  @param {string} [type] - Stamp type: "savings", "shipping", "info" (default: "info")
  @param {string} [class] - Additional CSS class

  @example
  {% render 'receipt-stamp', text: 'FREE SHIPPING', type: 'shipping' %}
{% enddoc %}

{%- liquid
  assign text = text | default: ''
  assign type = type | default: 'info'
  assign class = class | default: ''

  unless text != blank
    break
  endunless
-%}

<span class="receipt-stamp receipt-stamp--{{ type }} {{ class }}" aria-label="{{ text }}">
  {{ text }}
</span>
