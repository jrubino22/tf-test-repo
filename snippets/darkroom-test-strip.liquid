{% doc %}
  Darkroom Exposure Test Strip

  Renders a multi-band exposure visualization from a single collection image.
  Each band shows the same image at a different brightness/contrast/saturation,
  simulating a photographic test strip. Hover (desktop) or tap (mobile) develops
  all bands to correct exposure.

  @param {object} image - Shopify image object (required)
  @param {number} bands_count - Number of bands, 5 or 6 (default: 5)
  @param {number} correct_band - 1-based index of the correctly exposed band (default: 4)
  @param {string} alt_text - Alt text for the first band image (default: '')

  @example
  {% render 'darkroom-test-strip',
    image: collection.image,
    bands_count: 5,
    correct_band: 4,
    alt_text: collection.title
  %}
{% enddoc %}

{% liquid
  assign image = image | default: empty
  assign bands_count = bands_count | default: 5 | plus: 0
  assign correct_band = correct_band | default: 4 | plus: 0
  assign correct_band = correct_band | at_most: bands_count
  assign alt_text = alt_text | default: ''

  unless image != empty
    break
  endunless
%}

<darkroom-test-strip class="darkroom-test-strip" data-bands="{{ bands_count }}">
  <div class="darkroom-test-strip__bands">
    {% for i in (1..bands_count) %}
      {% liquid
        assign band_index = i | minus: 1

        case i
          when 1
            assign b_brightness = '1.8'
            assign b_contrast = '0.5'
            assign b_saturate = '0.3'
            assign exposure_time = '2s'
          when 2
            assign b_brightness = '1.4'
            assign b_contrast = '0.7'
            assign b_saturate = '0.6'
            assign exposure_time = '4s'
          when 3
            assign b_brightness = '1.15'
            assign b_contrast = '0.85'
            assign b_saturate = '0.8'
            assign exposure_time = '8s'
          when 4
            assign b_brightness = '1.0'
            assign b_contrast = '1.0'
            assign b_saturate = '1.0'
            assign exposure_time = '16s'
          when 5
            assign b_brightness = '0.7'
            assign b_contrast = '1.3'
            assign b_saturate = '0.9'
            assign exposure_time = '32s'
          when 6
            assign b_brightness = '0.45'
            assign b_contrast = '1.5'
            assign b_saturate = '0.7'
            assign exposure_time = '64s'
        endcase
      %}

      <div
        class="darkroom-test-strip__band"
        style="
          --band-index: {{ band_index }};
          --bands-count: {{ bands_count }};
          --band-brightness: {{ b_brightness }};
          --band-contrast: {{ b_contrast }};
          --band-saturate: {{ b_saturate }};
        "
      >
        {% liquid
          assign sizes_val = '(min-width: 990px) 1200px, (min-width: 750px) 900px, 600px'
        %}

        {% if forloop.first %}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'darkroom-test-strip__image',
              loading: 'eager',
              alt: alt_text,
              sizes: sizes_val,
              widths: '600,900,1200'
          }}
        {% else %}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'darkroom-test-strip__image',
              loading: 'eager',
              alt: '',
              aria-hidden: 'true',
              sizes: sizes_val,
              widths: '600,900,1200'
          }}
        {% endif %}

        <span class="darkroom-test-strip__label" aria-hidden="true">{{ exposure_time }}</span>

        {% if i == correct_band %}
          <svg class="darkroom-test-strip__mark" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="10" cy="10" r="7" stroke="rgb(var(--color-foreground-rgb) / 0.7)" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 3" fill="none"/>
          </svg>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</darkroom-test-strip>
