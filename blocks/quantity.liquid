{%- liquid
  assign in_receipt = false
  assign parent_block = block.parent
  if parent_block != blank and parent_block.settings.enable_receipt
    assign in_receipt = true
  endif
-%}

{%- if in_receipt -%}
  <div class="receipt-line-item" data-reprint {{ block.shopify_attributes }}>
    {% render 'receipt-line', label: 'QTY', value: '', bold: true %}
    {% render 'quantity-selector', product: closest.product, block: block %}
  </div>
{%- else -%}
  {%- if block.settings.input_style == 'custom' -%}
    {%- capture wrapper_class -%}quantity-selector-wrapper--block-{{ block.id }}{%- endcapture -%}
    {% style %}
      .{{ wrapper_class }} {
        {%- render 'input-custom-styles', block_settings: block.settings -%}
        --style-border-width-inputs: {{ block.settings.border_width }}px;
        --style-border-radius-inputs: {{ block.settings.border_radius }}px;
        --style-border-radius-buttons-primary: {{ block.settings.border_radius }}px;
        --style-border-radius-buttons-secondary: {{ block.settings.border_radius }}px;
      }
    {% endstyle %}
  {%- endif -%}

  {% render 'quantity-selector', product: closest.product, block: block, wrapper_class: wrapper_class %}
{%- endif -%}

{% stylesheet %}
  receipt-container .quantity-selector {
    font-family: var(--receipt-mono);
    font-size: var(--receipt-font-size, 0.8125rem);
  }

  receipt-container .quantity-selector input {
    font-family: var(--receipt-mono);
    background: transparent;
    border-color: var(--receipt-ink-faded);
    color: var(--receipt-ink);
  }

  receipt-container .quantity-selector button {
    font-family: var(--receipt-mono);
    color: var(--receipt-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.quantity",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
