{% render 'premium-buy-box-styles' %}

<script src="{{ 'premium-variant-picker.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign selected_variant = product_resource.selected_or_first_available_variant
  assign low_stock_threshold = block.settings.low_stock_threshold | default: 5
  assign fieldset_index = 0
-%}

{% unless product_resource.has_only_default_variant %}
  <premium-variant-picker
    class="pbb-variants spacing-style pbb-variants--{{ block.settings.alignment }}"
    style="{% render 'spacing-style', settings: block.settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-url="{{ product_resource.url }}"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <form class="pbb-variants__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign use_swatches = false
          if swatch_count > 0 and block.settings.show_swatches
            assign use_swatches = true
          endif

          assign variant_style = block.settings.variant_style
          if use_swatches
            assign variant_style = 'swatch'
          endif
        -%}

        {%- if variant_style == 'swatch' or variant_style == 'pills' -%}
          <fieldset
            class="pbb-variants__option pbb-variants__option--{{ variant_style }}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
          >
            <legend class="pbb-variants__legend">
              {{ product_option.name | escape -}}
              {%- if use_swatches -%}
                <span class="pbb-variants__selected-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            <div class="pbb-variants__values">
              {%- for product_option_value in product_option.values -%}
                {%- liquid
                  assign is_sold_out = false
                  if product_option_value.available == false
                    assign is_sold_out = true
                  endif

                  assign show_low_stock = false
                  if product_option_value.variant and product_option_value.variant.inventory_management == 'shopify'
                    if product_option_value.variant.inventory_quantity > 0 and product_option_value.variant.inventory_quantity <= low_stock_threshold
                      assign show_low_stock = true
                    endif
                  endif
                -%}
                <label
                  class="pbb-variants__label{% if use_swatches %} pbb-variants__label--swatch{% endif %}{% if is_sold_out %} pbb-variants__label--sold-out{% endif %}"
                >
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if is_sold_out %} - Sold out{% endif %}"
                    {% if is_sold_out %}aria-disabled="true"{% endif %}
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.variant.inventory_quantity %}
                      data-inventory-quantity="{{ product_option_value.variant.inventory_quantity }}"
                    {% endif %}
                    data-previous-checked="false"
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >
                  {% if use_swatches %}
                    {%- liquid
                      assign featured_media = product_option_value.variant.featured_media
                      if featured_media == blank and product_option_value.product_url
                        assign featured_media = product_option_value.variant.product.featured_media
                      endif
                    -%}
                    {% render 'swatch',
                      swatch: product_option_value.swatch,
                      variant_image: featured_media,
                      mode: 'unscaled'
                    %}
                  {% else %}
                    <span class="pbb-variants__pill-text">
                      {{- product_option_value | escape -}}
                    </span>
                  {% endif %}
                  {% if is_sold_out %}
                    {% render 'strikethrough-variant', product_option: product_option_value %}
                  {% endif %}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif variant_style == 'dropdowns' -%}
          <div class="pbb-variants__option pbb-variants__option--dropdown">
            <label for="PremiumOption-{{ block.id }}-{{ forloop.index0 }}">
              {{ product_option.name | escape }}
            </label>
            <div class="pbb-variants__select-wrapper">
              <select
                id="PremiumOption-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="pbb-variants__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}selected{% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - Sold out
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg aria-hidden="true" focusable="false" class="pbb-variants__caret" viewBox="0 0 10 6">
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>

    {%- liquid
      assign show_low_stock_msg = false
      if selected_variant and selected_variant.inventory_management == 'shopify'
        if selected_variant.inventory_quantity > 0 and selected_variant.inventory_quantity <= low_stock_threshold
          assign show_low_stock_msg = true
        endif
      endif
    -%}
    <p class="pbb-variants__low-stock" {% unless show_low_stock_msg %}hidden{% endunless %}>
      Only {{ selected_variant.inventory_quantity }} left in stock
    </p>
  </premium-variant-picker>
{% endunless %}

{% render 'swatch-styles' %}

{% stylesheet %}
  .pbb-variants {
    display: block;
  }

  .pbb-variants--left { text-align: start; }
  .pbb-variants--center { text-align: center; }
  .pbb-variants--right { text-align: end; }

  .pbb-variants__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .pbb-variants__option {
    border: none;
    padding: 0;
    margin: 0;
  }

  .pbb-variants__legend {
    display: block;
    font-size: var(--font-paragraph-small--size, 0.8125rem);
    font-weight: var(--font-weight-semibold, 600);
    color: rgb(var(--color-foreground-rgb));
    margin-block-end: var(--margin-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pbb-variants__selected-value {
    font-weight: var(--font-weight-normal, 400);
    margin-inline-start: 0.25em;
    text-transform: none;
    letter-spacing: normal;
  }

  .pbb-variants__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
  }

  .pbb-variants__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .pbb-variants__label input[type="radio"] {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Pill style */
  .pbb-variants__pill-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    padding: var(--padding-xs) var(--padding-md);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: var(--pbb-radius-md);
    font-size: var(--font-paragraph-small--size, 0.8125rem);
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb));
    background: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pbb-variants__pill-text {
      transition: border-color var(--pbb-speed-fast) var(--pbb-easing),
                  background-color var(--pbb-speed-fast) var(--pbb-easing);
    }
  }

  .pbb-variants__label input[type="radio"]:checked ~ .pbb-variants__pill-text {
    border-color: rgb(var(--color-foreground-rgb));
    background: rgb(var(--color-foreground-rgb) / 0.05);
    font-weight: var(--font-weight-semibold, 600);
  }

  .pbb-variants__label:hover .pbb-variants__pill-text {
    border-color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  /* Swatch style - uses theme swatch snippet */
  .pbb-variants__label--swatch {
    border-radius: 50%;
  }

  .pbb-variants__label--swatch input[type="radio"]:checked ~ .swatch {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: 2px;
  }

  /* Sold-out */
  .pbb-variants__label--sold-out {
    opacity: 0.4;
    cursor: default;
  }

  .pbb-variants__label--sold-out .pbb-variants__pill-text {
    text-decoration: line-through;
  }

  /* Dropdown style */
  .pbb-variants__option--dropdown label {
    display: block;
    font-size: var(--font-paragraph-small--size, 0.8125rem);
    font-weight: var(--font-weight-semibold, 600);
    color: rgb(var(--color-foreground-rgb));
    margin-block-end: var(--margin-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pbb-variants__select-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
    max-width: 300px;
  }

  .pbb-variants__select {
    appearance: none;
    width: 100%;
    padding: var(--padding-sm) var(--padding-xl) var(--padding-sm) var(--padding-md);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: var(--pbb-radius-md);
    background: transparent;
    font-size: var(--font-paragraph--size, 1rem);
    color: rgb(var(--color-foreground-rgb));
    cursor: pointer;
  }

  .pbb-variants__select:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: 2px;
  }

  .pbb-variants__caret {
    position: absolute;
    inset-inline-end: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 6px;
    pointer-events: none;
  }

  /* Low stock message */
  .pbb-variants__low-stock {
    font-size: var(--font-paragraph-small--size, 0.8125rem);
    color: var(--pbb-warning);
    font-weight: var(--font-weight-semibold, 600);
    margin-block-start: var(--margin-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Premium variants",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Animated variant picker with swatches, pills, and low-stock indicators."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Style",
      "options": [
        { "value": "pills", "label": "Pills" },
        { "value": "dropdowns", "label": "Dropdowns" }
      ],
      "default": "pills"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "number",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Premium variants",
      "category": "Product"
    }
  ]
}
{% endschema %}
