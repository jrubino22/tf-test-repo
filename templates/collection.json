{
  "sections": {
    "collection-header": {
      "type": "collection-header",
      "settings": {
        "title_size": "extra-large",
        "show_description": true,
        "show_exposure_count": true,
        "exposure_label": "exposures",
        "show_collection_image": false,
        "background_color": "#1a1a1a",
        "padding-block-start": 80,
        "padding-block-end": 48
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": false,
            "show_filter_label": false,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 20
          },
          "blocks": {}
        }
      },
      "settings": {
        "default_view": "index",
        "enable_animations": true,
        "loupe_zoom": "2.5",
        "products_per_page": 24,
        "enable_infinite_scroll": false,
        "padding-block-start": 0,
        "padding-block-end": 32
      }
    }
  },
  "order": [
    "collection-header",
    "main"
  ]
}
