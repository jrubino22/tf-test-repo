        "stat_1": {
          "type": "stat",
          "settings": {
            "value": 150,
            "suffix": "+",
            "label": "Products"
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "value": 12,
            "label": "Countries"
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "value": 50000,
            "suffix": "+",
            "label": "Customers"
          }
        },
        "stat_4": {
          "type": "stat",
          "settings": {
            "value": 99,
            "suffix": "%",
            "label": "Satisfaction"
          }
        }
      },
      "block_order": ["stat_1", "stat_2", "stat_3", "stat_4"],
      "settings": {
        "heading": "By The Numbers",
        "columns": 4,
        "gap": 32,
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "collection": {
      "type": "collection-reveal-grid",
      "settings": {
        "heading": "Featured Collection",
        "show_heading": true,
        "max_products": 8,
        "columns": 4,
        "gap": 20,
        "image_ratio": "portrait",
        "card_radius": 0,
        "show_price": true,
        "show_vendor": false,
        "animate_on_scroll": true,
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
