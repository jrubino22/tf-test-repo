      "type": "scroll-marquee",
      "blocks": {
        "text_1": {
          "type": "text-item",
          "settings": {
            "text": "New Collection"
          }
        },
        "sep_1": {
          "type": "separator",
          "settings": {
            "character": "·"
          }
        },
        "text_2": {
          "type": "text-item",
          "settings": {
            "text": "Free Shipping"
          }
        },
        "sep_2": {
          "type": "separator",
          "settings": {
            "character": "·"
          }
        },
        "text_3": {
          "type": "text-item",
          "settings": {
            "text": "Designed Different"
          }
        }
      },
      "block_order": ["text_1", "sep_1", "text_2", "sep_2", "text_3"],
      "settings": {
        "font_size": 48,
        "speed": 60,
        "text_transform": "uppercase",
        "letter_spacing": 4,
        "gap": 48,
        "section_width": "full-width",
        "padding-block-start": 24,
        "padding-block-end": 24
      }
    },
    "cta": {
      "type": "closing-cta",
      "settings": {
        "image_alt": "Call to action background",
        "heading": "Ready to Begin?",
