{
  "sections": {
    "opening": {
      "type": "layered-slideshow",
      "blocks": {
        "slide_1": {
          "type": "_layered-slide",
          "blocks": {
            "heading_1": {
              "type": "text",
              "settings": {
                "text": "<h2>New season</h2>",
                "type_preset": "h2"
              }
            },
            "button_1": {
              "type": "button",
              "settings": {
                "label": "Shop now",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["heading_1", "button_1"]
        },
        "slide_2": {
          "type": "_layered-slide",
          "blocks": {
            "heading_2": {
              "type": "text",
              "settings": {
                "text": "<h2>Curated for you</h2>",
                "type_preset": "h2"
              }
            },
            "button_2": {
              "type": "button",
              "settings": {
                "label": "Explore",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["heading_2", "button_2"]
        },
        "slide_3": {
          "type": "_layered-slide",
          "blocks": {
            "heading_3": {
              "type": "text",
              "settings": {
                "text": "<h2>Made different</h2>",
                "type_preset": "h2"
              }
            },
            "button_3": {
              "type": "button",
              "settings": {
                "label": "Discover",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["heading_3", "button_3"]
        }
      },
      "block_order": ["slide_1", "slide_2", "slide_3"],
      "settings": {
        "section_width": "full-width",
        "height": "large",
        "corner_radius": 0,
        "border_width": 1,
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "manifesto": {
      "type": "text-reveal",
      "blocks": {
        "line_1": {
          "type": "text-line",
          "settings": {
            "text": "Designed with",
            "size_override": "large"
          }
        },
        "line_2": {
          "type": "text-line",
          "settings": {
            "text": "intention.",
            "size_override": "jumbo",
            "font_override": "accent"
          }
        },
        "line_3": {
          "type": "text-line",
          "settings": {
            "text": "Built to last.",
            "size_override": "large"
          }
        }
      },
      "block_order": ["line_1", "line_2", "line_3"],
      "settings": {
        "animation_style": "fade-up",
        "text_alignment": "center",
        "section_height": "medium",
        "section_width": "page-width",
        "gap": 16,
        "padding-block-start": 80,
        "padding-block-end": 80
      }
    },
    "products": {
      "type": "stagger-grid",
      "settings": {
        "collection": "all",
        "heading": "New arrivals",
        "show_heading": true,
        "heading_type_preset": "h3",
        "show_view_all": true,
        "view_all_label": "View all",
        "max_products": 8,
        "columns": 3,
        "column_offset": 48,
        "card_gap": 16,
        "card_border_radius": 8,
        "image_ratio": "portrait",
        "show_price": true,
        "show_vendor": false,
        "animate_on_scroll": true,
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "ticker": {
      "type": "marquee",
      "blocks": {
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p>Free shipping on all orders</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h4)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>·</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h4)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>New arrivals every week</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h4)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        },
        "text_4": {
          "type": "text",
          "settings": {
            "text": "<p>·</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h4)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        },
        "text_5": {
          "type": "text",
          "settings": {
            "text": "<p>Designed with care</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h4)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["text_1", "text_2", "text_3", "text_4", "text_5"],
      "settings": {
        "movement_direction": "normal",
        "padding-block-start": 24,
        "padding-block-end": 24,
        "gap_between_elements": 48
      }
    },
    "showcase": {
      "type": "horizontal-showcase",
      "blocks": {
        "card_1": {
          "type": "showcase-card",
          "settings": {
            "heading": "Summer edit",
            "description": "Explore our curated selection",
            "link_label": "Explore"
          }
        },
        "card_2": {
          "type": "showcase-card",
          "settings": {
            "heading": "Best sellers",
            "description": "Our most popular pieces",
            "link_label": "Explore"
          }
        },
        "card_3": {
          "type": "showcase-card",
          "settings": {
            "heading": "New in",
            "description": "The latest additions",
            "link_label": "Explore"
          }
        }
      },
      "block_order": ["card_1", "card_2", "card_3"],
      "settings": {
        "heading": "Discover",
        "heading_alignment": "left",
        "card_width": 400,
        "card_gap": 24,
        "card_border_radius": 16,
        "section_width": "full-width",
        "padding-block-start": 60,
        "padding-block-end": 60
      }
    },
    "editorial": {
      "type": "media-with-content",
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "space-between"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h3>Our story</h3>",
                "type_preset": "h3"
              }
            },
            "body": {
              "type": "text",
              "settings": {
                "text": "<p>Every product we make starts with a question: does this need to exist? If the answer is yes, we craft it with intention, using materials that respect both the maker and the wearer.</p>",
                "type_preset": "rte",
                "max_width": "narrow"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "Learn more",
                "link": "",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["heading", "body", "button"]
        }
      },
      "settings": {
        "media_position": "left",
        "media_width": "medium",
        "media_height": "60svh",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "closing": {
      "type": "section",
      "blocks": {
        "quote_text": {
          "type": "text",
          "settings": {
            "text": "<h2>We believe great design should be felt, not explained.</h2>",
            "type_preset": "h2",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center"
          }
        },
        "quote_button": {
          "type": "button",
          "settings": {
            "label": "Start exploring",
            "link": "shopify://collections/all",
            "style_class": "button-unstyled"
          }
        }
      },
      "block_order": ["quote_text", "quote_button"],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height": "medium",
        "background_media": "none",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "opening",
    "manifesto",
    "products",
    "ticker",
    "showcase",
    "editorial",
    "closing"
  ]
}
