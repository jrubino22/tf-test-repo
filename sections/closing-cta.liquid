<script
  src="{{ 'closing-cta.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<closing-cta-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --closing-cta-min-height: {{ section.settings.min_height }};
    --closing-cta-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="closing-cta__media" ref="media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '375,750,1100,1500,1920,2400',
          alt: section.settings.image_alt,
          class: 'closing-cta__img'
      }}
    {% else %}
      <img
        src="{{ 'closing-cta-bg.svg' | asset_url }}"
        alt="{{ section.settings.image_alt }}"
        width="1440"
        height="900"
        loading="lazy"
        class="closing-cta__img"
      >
    {% endif %}
  </div>

  <div class="closing-cta__overlay"></div>

  <div class="closing-cta__content" ref="content">
    {% if section.settings.heading != blank %}
      <h2 class="closing-cta__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
        class="closing-cta__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</closing-cta-section>

{% stylesheet %}
  closing-cta-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--closing-cta-min-height, 75svh);
    overflow: hidden;
  }

  .closing-cta__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }

  .closing-cta__img {
    display: block;
    width: 100%;
    height: 120%;
    object-fit: cover;
  }

  .closing-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / calc(var(--closing-cta-overlay-opacity, 0.5) * 0.3)),
      rgb(0 0 0 / var(--closing-cta-overlay-opacity, 0.5))
    );
    pointer-events: none;
  }

  .closing-cta__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lg, 2rem);
    text-align: center;
    padding-inline: var(--padding-md, 1.5rem);
    max-width: 40rem;
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .closing-cta__content {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
                  transform 0.8s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
    }

    .closing-cta__content.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .closing-cta__content {
      opacity: 1;
      transform: none;
    }
  }

  .closing-cta__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, var(--font-size--5xl, 3rem));
    font-weight: var(--font-heading--weight, 700);
    line-height: var(--line-height--display-tight, 1.0);
    margin: 0;
  }

  .closing-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2.5rem;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    background-color: #fff;
    border: none;
    border-radius: var(--button-border-radius, 0);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .closing-cta__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 768px) {
    closing-cta-section {
      min-height: 60svh;
    }

    .closing-cta__heading {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Closing CTA",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Call to action background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Begin?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Minimum height",
      "options": [
        { "value": "50svh", "label": "Small" },
        { "value": "75svh", "label": "Medium" },
        { "value": "100svh", "label": "Full screen" }
      ],
      "default": "75svh"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Closing CTA",
      "category": "Call to action"
    }
  ]
}
{% endschema %}
