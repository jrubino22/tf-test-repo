<script
  src="{{ 'aperture-collections.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<aperture-collections-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --aperture-columns: {{ section.settings.columns_desktop }};
    --aperture-gap: {{ section.settings.gap }}px;
    --aperture-start: {{ section.settings.aperture_start }}%;
  "
  data-aperture-start="{{ section.settings.aperture_start }}"
>
  {% if section.settings.show_heading and section.settings.heading != blank %}
    <div class="aperture-collections__header">
      <h2 class="aperture-collections__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="aperture-collections__grid">
    {% for block in section.blocks %}
      {% liquid
        assign block_collection = block.settings.collection
        assign label = block.settings.label_override
        if label == blank and block_collection != blank
          assign label = block_collection.title
        endif
        if label == blank
          assign label = 'Collection'
        endif
      %}
      <div
        class="aperture-collections__portal"
        ref="portals[]"
        {{ block.shopify_attributes }}
      >
        <div class="aperture-collections__portal-media">
          {% if block_collection != blank and block_collection.image %}
            {{
              block_collection.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                widths: '200,300,400,600,800',
                alt: block_collection.image.alt
            }}
          {% elsif block_collection != blank and block_collection.products.first.featured_image %}
            {{
              block_collection.products.first.featured_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                widths: '200,300,400,600,800',
                alt: block_collection.title
            }}
          {% else %}
            <div class="aperture-collections__placeholder">
              {{ 'collection-1' | placeholder_svg_tag: 'aperture-collections__placeholder-svg' }}
            </div>
          {% endif %}
        </div>
        {% if block_collection != blank %}
          <a href="{{ block_collection.url }}" class="aperture-collections__portal-label">
            {{ label }}
          </a>
        {% else %}
          <span class="aperture-collections__portal-label">{{ label }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</aperture-collections-section>

{% stylesheet %}
  aperture-collections-section {
    display: block;
  }

  .aperture-collections__header {
    margin-block-end: 2rem;
    text-align: center;
  }

  .aperture-collections__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
  }

  .aperture-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--aperture-columns, 3), 1fr);
    gap: var(--aperture-gap, 24px);
  }

  .aperture-collections__portal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .aperture-collections__portal-media {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    border-radius: 50%;
    clip-path: circle(var(--aperture-radius, var(--aperture-start, 20%)) at 50% 50%);
    transition: clip-path 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04);
  }

  .aperture-collections__portal-media img,
  .aperture-collections__portal-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aperture-collections__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.06);
  }

  .aperture-collections__placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  .aperture-collections__portal-label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    text-decoration: none;
    color: inherit;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  a.aperture-collections__portal-label:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a.aperture-collections__portal-label:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* Hover: boost aperture via CSS as fallback */
  .aperture-collections__portal:hover .aperture-collections__portal-media {
    clip-path: circle(calc(var(--aperture-radius, var(--aperture-start, 20%)) + 5%) at 50% 50%);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .aperture-collections__portal-media {
      clip-path: circle(71% at 50% 50%);
      transition: none;
    }

    .aperture-collections__portal:hover .aperture-collections__portal-media {
      clip-path: circle(71% at 50% 50%);
      transform: scale(1.02);
      transition: transform 0.2s ease;
    }
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    .aperture-collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .aperture-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aperture collections",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "portal",
      "name": "Collection portal",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label_override",
          "label": "Label override",
          "info": "Overrides the collection title"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "aperture_start",
      "label": "Aperture start size",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Aperture collections",
      "category": "Collections",
      "blocks": [
        {
          "type": "portal",
          "settings": {}
        },
        {
          "type": "portal",
          "settings": {}
        },
        {
          "type": "portal",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
