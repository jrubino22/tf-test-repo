{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign title_size_class = 'darkroom-header__title--' | append: section.settings.title_size
%}

<div
  class="darkroom-header{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --darkroom-header-padding-top: {{ section.settings.padding-block-start }}px;
    --darkroom-header-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="darkroom-header__inner">
    <h1 class="darkroom-header__title {{ title_size_class }}">
      {{ collection.title }}
    </h1>

    {% if section.settings.show_description and collection.description != blank %}
      <div class="darkroom-header__description">
        {{ collection.description }}
      </div>
    {% endif %}

    {% if section.settings.show_exposure_count %}
      <p class="darkroom-header__exposures">
        {{ collection.products_count }} {{ section.settings.exposure_label }}
      </p>
    {% endif %}

    {% if section.settings.show_test_strip %}
      {% liquid
        assign strip_image = collection.image | default: section.settings.test_strip_fallback_image
        assign bands_int = section.settings.test_strip_bands | plus: 0
        assign correct_clamped = section.settings.test_strip_correct_band | at_most: bands_int
      %}
      {% if strip_image != blank %}
        {% render 'darkroom-test-strip', image: strip_image, bands_count: bands_int, correct_band: correct_clamped, alt_text: collection.title %}
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection header",
  "tag": "div",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "extra-large"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_exposure_count",
      "label": "Show exposure count",
      "default": true
    },
    {
      "type": "text",
      "id": "exposure_label",
      "label": "Exposure count label",
      "default": "exposures"
    },
    {
      "type": "header",
      "content": "Test Strip"
    },
    {
      "type": "checkbox",
      "id": "show_test_strip",
      "label": "Show test strip",
      "default": true
    },
    {
      "type": "select",
      "id": "test_strip_bands",
      "label": "Number of bands",
      "options": [
        { "value": "5", "label": "5 bands" },
        { "value": "6", "label": "6 bands" }
      ],
      "default": "5",
      "visible_if": "{{ section.settings.show_test_strip }}"
    },
    {
      "type": "image_picker",
      "id": "test_strip_fallback_image",
      "label": "Fallback image",
      "visible_if": "{{ section.settings.show_test_strip }}"
    },
    {
      "type": "range",
      "id": "test_strip_correct_band",
      "label": "Correct exposure band",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.show_test_strip }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Collection header"
    }
  ]
}
{% endschema %}
