{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign title_size_class = 'darkroom-header__title--' | append: section.settings.title_size
%}

<div
  class="darkroom-header{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --darkroom-header-padding-top: {{ section.settings.padding-block-start }}px;
    --darkroom-header-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="darkroom-header__inner">
    <h1 class="darkroom-header__title {{ title_size_class }}">
      {{ collection.title }}
    </h1>

    {% if section.settings.show_description and collection.description != blank %}
      <div class="darkroom-header__description">
        {{ collection.description }}
      </div>
    {% endif %}

    {% if section.settings.show_exposure_count %}
      <p class="darkroom-header__exposures">
        {{ collection.products_count }} {{ section.settings.exposure_label }}
      </p>
    {% endif %}

    {% if section.settings.show_collection_image and collection.image != blank %}
      <div class="darkroom-header__image-frame">
        {{
          collection.image
          | image_url: width: 400
          | image_tag:
            loading: 'eager',
            alt: collection.title,
            class: 'darkroom-header__image'
        }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection header",
  "tag": "div",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "extra-large"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_exposure_count",
      "label": "Show exposure count",
      "default": true
    },
    {
      "type": "text",
      "id": "exposure_label",
      "label": "Exposure count label",
      "default": "exposures"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": false
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Collection header"
    }
  ]
}
{% endschema %}
