<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'darkroom.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign products_per_page = section.settings.products_per_page | default: 24
%}

{% render 'darkroom-styles' %}
{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="darkroom{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
    style="
      --darkroom-padding-top: {{ section.settings.padding-block-start }}px;
      --darkroom-padding-bottom: {{ section.settings.padding-block-end }}px;
      --loupe-zoom: {{ section.settings.loupe_zoom }};
    "
  >
    {% render 'skip-to-content-link', href: '#DarkroomContent', text: 'accessibility.skip_to_results_list' %}

    <darkroom-collection
      class="darkroom__inner collection-wrapper grid gap-style"
      data-default-view="{{ section.settings.default_view }}"
      data-enable-animations="{{ section.settings.enable_animations }}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      <div class="darkroom-toolbar">
        <div class="darkroom-toggle" role="group" aria-label="View mode">
          <button
            type="button"
            class="darkroom-toggle__btn"
            data-view="index"
            aria-pressed="{% if section.settings.default_view == 'index' %}true{% else %}false{% endif %}"
          >
            Index
          </button>
          <button
            type="button"
            class="darkroom-toggle__btn"
            data-view="sheet"
            aria-pressed="{% if section.settings.default_view == 'sheet' %}true{% else %}false{% endif %}"
          >
            Contact Sheet
          </button>
        </div>
      </div>

      {% paginate collection.products by products_per_page %}
        {% if collection.products.size == 0 %}
          <div class="darkroom-empty">
            <h2 class="darkroom-empty__heading">No exposures found</h2>
            <p class="darkroom-empty__text">
              Try adjusting your filters or browse the full collection to find what you're looking for.
            </p>
            <a href="{{ collection.url }}" class="darkroom-empty__link">
              View all products
            </a>
          </div>
        {% else %}
          {% if section.settings.enable_infinite_scroll %}
            <span ref="viewMorePrevious"></span>
          {% endif %}

          <div id="DarkroomContent" ref="grid" data-last-page="{{ paginate.pages }}">
            {% liquid
              assign current_page = paginate.current_page | default: 1
              assign per_page_int = products_per_page | times: 1
              assign page_offset = current_page | minus: 1 | times: per_page_int
            %}

            {% render 'darkroom-index', products: collection.products, page_offset: page_offset, enable_drying_lines: section.settings.enable_drying_lines, drying_line_interval: section.settings.drying_line_interval, drying_line_prints: section.settings.drying_line_prints %}
            {% render 'darkroom-contact-sheet', products: collection.products, page_offset: page_offset %}
          </div>

          {% if section.settings.enable_infinite_scroll %}
            <span ref="viewMoreNext" class="darkroom__view-more"></span>
          {% else %}
            {% if paginate.pages > 1 %}
              <nav class="darkroom-pagination" aria-label="Pagination">
                {% if paginate.previous %}
                  <a
                    href="{{ paginate.previous.url }}"
                    class="darkroom-pagination__link"
                    aria-label="Previous page"
                  >
                    &larr; Previous
                  </a>
                {% else %}
                  <span class="darkroom-pagination__link darkroom-pagination__link--disabled" aria-disabled="true">
                    &larr; Previous
                  </span>
                {% endif %}

                <span class="darkroom-pagination__indicator">
                  {{ paginate.current_page }} / {{ paginate.pages }}
                </span>

                {% if paginate.next %}
                  <a
                    href="{{ paginate.next.url }}"
                    class="darkroom-pagination__link"
                    aria-label="Next page"
                  >
                    Next &rarr;
                  </a>
                {% else %}
                  <span class="darkroom-pagination__link darkroom-pagination__link--disabled" aria-disabled="true">
                    Next &rarr;
                  </span>
                {% endif %}
              </nav>
            {% endif %}
          {% endif %}
        {% endif %}
      {% endpaginate %}

      {%- comment -%} Fullscreen dialog for mobile zoom {%- endcomment -%}
      <dialog class="darkroom-fullscreen" id="DarkroomFullscreen-{{ section.id }}">
        <button type="button" class="darkroom-fullscreen__close" aria-label="Close preview">&times;</button>
        <img class="darkroom-fullscreen__image" src="" alt="">
      </dialog>
    </darkroom-collection>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Darkroom"
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Default view",
      "options": [
        { "value": "index", "label": "Index" },
        { "value": "sheet", "label": "Contact Sheet" }
      ],
      "default": "index"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable animations",
      "default": true
    },
    {
      "type": "select",
      "id": "loupe_zoom",
      "label": "Loupe zoom level",
      "options": [
        { "value": "2", "label": "2×" },
        { "value": "2.5", "label": "2.5×" },
        { "value": "3", "label": "3×" },
        { "value": "4", "label": "4×" }
      ],
      "default": "2.5"
    },
    {
      "type": "header",
      "content": "Drying Line"
    },
    {
      "type": "checkbox",
      "id": "enable_drying_lines",
      "label": "Show drying lines",
      "default": true
    },
    {
      "type": "range",
      "id": "drying_line_interval",
      "label": "Rows between lines",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "visible_if": "{{ section.settings.enable_drying_lines }}"
    },
    {
      "type": "range",
      "id": "drying_line_prints",
      "label": "Prints per line",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.enable_drying_lines }}"
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "Auto load products",
      "default": false
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": []
}
{% endschema %}
