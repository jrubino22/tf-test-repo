<script
  src="{{ 'creative-hero.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<creative-hero-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --creative-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="creative-hero__media" ref="media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '375,750,1100,1500,1920,2400',
          alt: section.settings.image_alt,
          class: 'creative-hero__img'
      }}
    {% else %}
      <img
        src="{{ 'creative-hero-bg.svg' | asset_url }}"
        alt="{{ section.settings.image_alt }}"
        width="1440"
        height="900"
        loading="eager"
        class="creative-hero__img"
      >
    {% endif %}
  </div>

  <div class="creative-hero__overlay"></div>

  <div class="creative-hero__content" ref="content">
    {% if section.settings.heading != blank %}
      <h1 class="creative-hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="creative-hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
        class="creative-hero__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</creative-hero-section>

{% stylesheet %}
  creative-hero-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    overflow: hidden;
  }

  .creative-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }

  .creative-hero__img {
    display: block;
    width: 100%;
    height: 120%;
    object-fit: cover;
  }

  .creative-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / calc(var(--creative-hero-overlay-opacity, 0.4) * 0.5)),
      rgb(0 0 0 / var(--creative-hero-overlay-opacity, 0.4))
    );
    pointer-events: none;
  }

  .creative-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md, 1.5rem);
    text-align: center;
    padding-inline: var(--padding-md, 1.5rem);
    max-width: 48rem;
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .creative-hero__content {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1)),
                  transform 0.8s var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
    }

    .creative-hero__content.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .creative-hero__content {
      opacity: 1;
      transform: none;
    }
  }

  .creative-hero__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 6vw, var(--font-size--5xl, 3rem));
    font-weight: var(--font-heading--weight, 700);
    line-height: var(--line-height--display-tight, 1.0);
    letter-spacing: var(--letter-spacing--heading-normal, 0);
    margin: 0;
  }

  .creative-hero__subheading {
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 2vw, var(--font-size--lg, 1.125rem));
    line-height: var(--line-height--body-normal, 1.4);
    margin: 0;
    opacity: 0.85;
  }

  .creative-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    background-color: #fff;
    border: none;
    border-radius: var(--button-border-radius, 0);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .creative-hero__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 768px) {
    .creative-hero__heading {
      font-size: clamp(2rem, 8vw, 2.5rem);
    }

    .creative-hero__content {
      padding-inline: var(--padding-sm, 1rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Creative hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hero background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Push Boundaries"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Design beyond convention"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Creative hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
