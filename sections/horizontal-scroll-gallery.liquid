<script
  src="{{ 'horizontal-scroll-gallery.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<horizontal-scroll-gallery-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --hscroll-item-width: {{ section.settings.item_width }}px;
    --hscroll-item-gap: {{ section.settings.item_gap }}px;
  "
>
  {% if section.settings.heading != blank %}
    <div class="hscroll-gallery__header">
      <h2 class="hscroll-gallery__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="hscroll-gallery__viewport">
    <div class="hscroll-gallery__track" ref="track">
      {% for block in section.blocks %}
        {% liquid
          assign fallback_index = forloop.index
          if fallback_index > 5
            assign fallback_index = fallback_index | modulo: 5
            if fallback_index == 0
              assign fallback_index = 5
            endif
          endif
          assign fallback_svg = 'gallery-' | append: fallback_index | append: '.svg'
        %}
        <div class="hscroll-gallery__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="hscroll-gallery__item-link">
          {% endif %}
          <div class="hscroll-gallery__item-media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 768px) 480px, 80vw',
                  widths: '300,400,500,600,800',
                  alt: block.settings.image_alt,
                  class: 'hscroll-gallery__item-img'
              }}
            {% else %}
              <img
                src="{{ fallback_svg | asset_url }}"
                alt="{{ block.settings.image_alt }}"
                width="480"
                height="640"
                loading="lazy"
                class="hscroll-gallery__item-img"
              >
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <p class="hscroll-gallery__item-title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</horizontal-scroll-gallery-section>

{% stylesheet %}
  horizontal-scroll-gallery-section {
    display: block;
    position: relative;
    /* On desktop, section height creates scroll distance for horizontal translation.
       Track total width is set by JS via --track-translate-distance */
    height: calc(100svh + var(--track-translate-distance, 0px));
  }

  .hscroll-gallery__header {
    padding-inline: var(--padding-md, 1.5rem);
    padding-block-end: var(--gap-lg, 2rem);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .hscroll-gallery__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, var(--font-size--3xl, 2rem));
    font-weight: var(--font-heading--weight, 700);
    line-height: var(--line-height--display-tight, 1.0);
    margin: 0;
  }

  .hscroll-gallery__viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hscroll-gallery__track {
    display: flex;
    gap: var(--hscroll-item-gap, 24px);
    padding-inline: var(--padding-md, 1.5rem);
    will-change: transform;
  }

  .hscroll-gallery__item {
    flex-shrink: 0;
    width: var(--hscroll-item-width, 480px);
  }

  .hscroll-gallery__item-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .hscroll-gallery__item-media {
    overflow: hidden;
    border-radius: var(--card-corner-radius, 8px);
  }

  .hscroll-gallery__item-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-cubic, ease);
  }

  .hscroll-gallery__item:hover .hscroll-gallery__item-img {
    transform: scale(1.03);
  }

  .hscroll-gallery__item-title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    margin-block-start: 0.75rem;
    margin-block-end: 0;
  }

  /* Mobile: native horizontal scroll, no sticky/translation */
  @media screen and (max-width: 768px) {
    horizontal-scroll-gallery-section {
      height: auto;
    }

    .hscroll-gallery__header {
      position: relative;
    }

    .hscroll-gallery__viewport {
      position: relative;
      height: auto;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .hscroll-gallery__viewport::-webkit-scrollbar {
      display: none;
    }

    .hscroll-gallery__track {
      will-change: auto;
    }

    .hscroll-gallery__item {
      width: 75vw;
      max-width: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Horizontal scroll gallery",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "item_width",
      "label": "Item width",
      "min": 300,
      "max": 800,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "gallery-item",
      "name": "Gallery item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Gallery image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Horizontal scroll gallery",
      "category": "Gallery",
      "blocks": [
        { "type": "gallery-item", "settings": { "image_alt": "Gallery image 1", "title": "Look One" } },
        { "type": "gallery-item", "settings": { "image_alt": "Gallery image 2", "title": "Look Two" } },
        { "type": "gallery-item", "settings": { "image_alt": "Gallery image 3", "title": "Look Three" } },
        { "type": "gallery-item", "settings": { "image_alt": "Gallery image 4", "title": "Look Four" } },
        { "type": "gallery-item", "settings": { "image_alt": "Gallery image 5", "title": "Look Five" } }
      ]
    }
  ]
}
{% endschema %}
