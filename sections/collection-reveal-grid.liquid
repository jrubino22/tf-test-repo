<script
  src="{{ 'collection-reveal-grid.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign collection = section.settings.collection
  assign max_products = section.settings.max_products
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-reveal-grid-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --collection-grid-columns: {{ section.settings.columns }};
    --collection-grid-gap: {{ section.settings.gap }}px;
    --collection-grid-radius: {{ section.settings.card_radius }}px;
  "
>
  {% if section.settings.show_heading and section.settings.heading != blank %}
    <div class="collection-grid__header">
      <h2 class="collection-grid__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="collection-grid__grid">
    {% if collection != blank and collection.products.size > 0 %}
      {% for product in collection.products limit: max_products %}
        <a
          href="{{ product.url }}"
          class="collection-grid__card{% if section.settings.animate_on_scroll %} collection-grid__card--animate{% endif %}"
          style="--card-index: {{ forloop.index0 }}"
          ref="cards[]"
        >
          <div class="collection-grid__card-media collection-grid__card-media--{{ section.settings.image_ratio }}">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 992px) 25vw, (min-width: 768px) 33vw, 50vw',
                  widths: '200,300,400,600,800',
                  alt: product.featured_image.alt,
                  class: 'collection-grid__card-img collection-grid__card-img--primary'
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'collection-grid__placeholder-svg' }}
            {% endif %}
            {% if product.images[1] != blank %}
              {{
                product.images[1]
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 992px) 25vw, (min-width: 768px) 33vw, 50vw',
                  widths: '200,300,400,600,800',
                  alt: product.images[1].alt,
                  class: 'collection-grid__card-img collection-grid__card-img--secondary'
              }}
            {% endif %}
          </div>
          <div class="collection-grid__card-info">
            <h3 class="collection-grid__card-title">{{ product.title }}</h3>
            {% if section.settings.show_vendor and product.vendor != blank %}
              <span class="collection-grid__card-vendor">{{ product.vendor }}</span>
            {% endif %}
            {% if section.settings.show_price %}
              <span class="collection-grid__card-price">{{ product.price | money }}</span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..max_products) %}
        <div class="collection-grid__card collection-grid__card--placeholder" style="--card-index: {{ forloop.index0 }}" ref="cards[]">
          <div class="collection-grid__card-media collection-grid__card-media--{{ section.settings.image_ratio }}">
            {{ 'product-1' | placeholder_svg_tag: 'collection-grid__placeholder-svg' }}
          </div>
          <div class="collection-grid__card-info">
            <h3 class="collection-grid__card-title">Example Product {{ forloop.index }}</h3>
            <span class="collection-grid__card-price">$0.00</span>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</collection-reveal-grid-section>

{% stylesheet %}
  collection-reveal-grid-section {
    display: block;
    position: relative;
  }

  .collection-grid__header {
    margin-block-end: var(--gap-lg, 2rem);
  }

  .collection-grid__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, var(--font-size--3xl, 2rem));
    font-weight: var(--font-heading--weight, 700);
    line-height: var(--line-height--display-tight, 1.0);
    margin: 0;
  }

  .collection-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-grid-columns, 4), 1fr);
    gap: var(--collection-grid-gap, 20px);
  }

  .collection-grid__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Staggered reveal animation */
  @media (prefers-reduced-motion: no-preference) {
    .collection-grid__card--animate {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s var(--ease-out-cubic, ease),
                  transform 0.6s var(--ease-out-cubic, ease);
      transition-delay: calc(var(--card-index, 0) * 80ms);
    }

    .collection-grid__card--animate.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-grid__card--animate {
      opacity: 1;
      transform: none;
    }
  }

  .collection-grid__card-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--collection-grid-radius, 0);
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.05);
  }

  .collection-grid__card-media--portrait {
    aspect-ratio: 3 / 4;
  }

  .collection-grid__card-media--square {
    aspect-ratio: 1 / 1;
  }

  .collection-grid__card-media--landscape {
    aspect-ratio: 4 / 3;
  }

  .collection-grid__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-cubic, ease);
  }

  .collection-grid__card-img--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out-cubic, ease);
  }

  .collection-grid__card:hover .collection-grid__card-img--primary {
    transform: scale(1.05);
  }

  .collection-grid__card:hover .collection-grid__card-img--secondary {
    opacity: 1;
    transform: scale(1.05);
  }

  .collection-grid__card-info {
    padding-block-start: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .collection-grid__card-title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 500;
    line-height: var(--line-height--body-normal, 1.4);
    margin: 0;
  }

  .collection-grid__card-vendor {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs, 0.75rem);
    opacity: 0.6;
  }

  .collection-grid__card-price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
  }

  .collection-grid__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .collection-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection reveal grid",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate_on_scroll",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection reveal grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
