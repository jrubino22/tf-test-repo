<script
  src="{{ 'product-velocity.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign collection = section.settings.collection
  assign max_products = section.settings.max_products
  assign columns = section.settings.columns_desktop
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<product-velocity-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --velocity-columns: {{ columns }};
    --velocity-card-radius: {{ section.settings.card_border_radius }}px;
  "
>
  {% if section.settings.show_heading %}
    <div class="product-velocity__header">
      <h2 class="product-velocity__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="product-velocity__grid">
    {% if collection != blank and collection.products.size > 0 %}
      {% for product in collection.products limit: max_products %}
        <a
          href="{{ product.url }}"
          class="product-velocity__card"
          ref="cards[]"
        >
          <div class="product-velocity__card-media">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '200,300,400,600,800',
                  alt: product.featured_image.alt
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-velocity__placeholder' }}
            {% endif %}
          </div>
          <div class="product-velocity__card-info">
            <h3 class="product-velocity__card-title">{{ product.title }}</h3>
            <span class="product-velocity__card-price">{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..max_products) %}
        <div
          class="product-velocity__card"
          ref="cards[]"
        >
          <div class="product-velocity__card-media">
            {{ 'product-1' | placeholder_svg_tag: 'product-velocity__placeholder' }}
          </div>
          <div class="product-velocity__card-info">
            <h3 class="product-velocity__card-title">Sample product</h3>
            <span class="product-velocity__card-price">$0.00</span>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</product-velocity-section>

{% stylesheet %}
  product-velocity-section {
    display: block;
  }

  .product-velocity__header {
    margin-block-end: 1.5rem;
  }

  .product-velocity__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
  }

  .product-velocity__grid {
    display: grid;
    grid-template-columns: repeat(var(--velocity-columns, 3), 1fr);
    gap: 1.5rem;
  }

  .product-velocity__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--velocity-card-radius, 8px);
    overflow: hidden;
    opacity: 0;
    transform:
      translate(var(--start-x, 0px), var(--start-y, 0px))
      rotate(var(--start-r, 0deg));
    will-change: transform, opacity;
    transition:
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--card-index, 0) * 0.06s);
  }

  .product-velocity__card.is-settled {
    opacity: 1;
    transform: none;
  }

  .product-velocity__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-velocity__card-media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--velocity-card-radius, 8px);
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04);
  }

  .product-velocity__card-media img,
  .product-velocity__card-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-velocity__placeholder {
    width: 100%;
    height: 100%;
  }

  .product-velocity__card-info {
    padding-block: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .product-velocity__card-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .product-velocity__card-price {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .product-velocity__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    .product-velocity__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .product-velocity__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product velocity",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Product velocity",
      "category": "Products"
    }
  ]
}
{% endschema %}
