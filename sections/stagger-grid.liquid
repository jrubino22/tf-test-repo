<script
  src="{{ 'stagger-grid.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign collection = section.settings.collection
  assign max_products = section.settings.max_products
  assign columns = section.settings.columns
  assign animate = section.settings.animate_on_scroll
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<stagger-grid-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --stagger-columns: {{ columns }};
    --stagger-card-gap: {{ section.settings.card_gap }}px;
    --stagger-column-offset: {{ section.settings.column_offset }}px;
    --stagger-card-radius: {{ section.settings.card_border_radius }}px;
  "
>
  {% if section.settings.show_heading %}
    <div class="stagger-grid__header">
      <{{ section.settings.heading_type_preset }} class="stagger-grid__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_type_preset }}>
      {% if section.settings.show_view_all and collection != blank %}
        <a href="{{ collection.url }}" class="stagger-grid__view-all">
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="stagger-grid__grid">
    {% if collection != blank and collection.products.size > 0 %}
      {% comment %} Build columns {% endcomment %}
      {% for i in (1..columns) %}
        {% assign col_index = i | minus: 1 %}
        <div class="stagger-grid__column" style="--col-index: {{ col_index }}">
          {% for product in collection.products limit: max_products %}
            {% assign product_col = forloop.index0 | modulo: columns %}
            {% if product_col == col_index %}
              <a
                href="{{ product.url }}"
                class="stagger-grid__card{% if animate %} stagger-grid__card--animate{% endif %}"
                style="--card-index: {{ forloop.index0 }}"
                ref="cards[]"
              >
                <div class="stagger-grid__card-media stagger-grid__card-media--{{ section.settings.image_ratio }}">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(max-width: 40em) 50vw, 33vw',
                        widths: '200,300,400,600,800',
                        alt: product.featured_image.alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'stagger-grid__placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="stagger-grid__card-info">
                  <h3 class="stagger-grid__card-title">{{ product.title }}</h3>
                  {% if section.settings.show_vendor and product.vendor != blank %}
                    <span class="stagger-grid__card-vendor">{{ product.vendor }}</span>
                  {% endif %}
                  {% if section.settings.show_price %}
                    <span class="stagger-grid__card-price">{{ product.price | money }}</span>
                  {% endif %}
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    {% else %}
      {% comment %} Placeholder state {% endcomment %}
      {% for i in (1..columns) %}
        {% assign col_index = i | minus: 1 %}
        <div class="stagger-grid__column" style="--col-index: {{ col_index }}">
          {% assign cards_per_col = max_products | divided_by: columns %}
          {% for j in (1..cards_per_col) %}
            {% assign card_global_index = col_index | plus: j | minus: 1 | times: columns | plus: col_index %}
            <div
              class="stagger-grid__card{% if animate %} stagger-grid__card--animate{% endif %}"
              style="--card-index: {{ card_global_index }}"
              ref="cards[]"
            >
              <div class="stagger-grid__card-media stagger-grid__card-media--{{ section.settings.image_ratio }}">
                {% assign placeholder_index = j | modulo: 6 | plus: 1 %}
                {{ 'product-1' | placeholder_svg_tag: 'stagger-grid__placeholder-svg' }}
              </div>
              <div class="stagger-grid__card-info">
                <h3 class="stagger-grid__card-title">Sample product</h3>
                {% if section.settings.show_price %}
                  <span class="stagger-grid__card-price">$0.00</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</stagger-grid-section>

{% stylesheet %}
  stagger-grid-section {
    display: block;
  }

  .stagger-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-block-end: var(--stagger-card-gap, 16px);
  }

  .stagger-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
  }

  .stagger-grid__view-all {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: inherit;
  }

  .stagger-grid__view-all:hover {
    opacity: 0.7;
  }

  .stagger-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--stagger-columns, 3), 1fr);
    gap: var(--stagger-card-gap, 16px);
  }

  .stagger-grid__column {
    display: flex;
    flex-direction: column;
    gap: var(--stagger-card-gap, 16px);
  }

  @media screen and (min-width: 40em) {
    .stagger-grid__column:nth-child(even) {
      transform: translateY(var(--stagger-column-offset, 48px));
    }
  }

  .stagger-grid__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--stagger-card-radius, 8px);
    overflow: hidden;
  }

  .stagger-grid__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .stagger-grid__card-media {
    overflow: hidden;
    border-radius: var(--stagger-card-radius, 8px);
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04);
  }

  .stagger-grid__card-media img,
  .stagger-grid__card-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stagger-grid__card-media--portrait {
    aspect-ratio: 3 / 4;
  }

  .stagger-grid__card-media--square {
    aspect-ratio: 1 / 1;
  }

  .stagger-grid__card-media--landscape {
    aspect-ratio: 4 / 3;
  }

  .stagger-grid__card-media--adapt {
    aspect-ratio: auto;
  }

  .stagger-grid__placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .stagger-grid__card-info {
    padding-block: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stagger-grid__card-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .stagger-grid__card-vendor {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .stagger-grid__card-price {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  /* Animate on scroll */
  .stagger-grid__card--animate {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--card-index, 0) * 0.08s);
  }

  .stagger-grid__card--animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .stagger-grid__card--animate {
      transform: none;
      transition: opacity 0.4s ease;
      transition-delay: 0s;
    }

    .stagger-grid__card--animate.is-visible {
      opacity: 1;
    }

    .stagger-grid__column:nth-child(even) {
      transform: none;
    }
  }

  /* Mobile: force 2 columns with halved offset */
  @media screen and (max-width: 40em) {
    .stagger-grid__grid {
      --stagger-columns: 2;
    }

    .stagger-grid__column:nth-child(even) {
      transform: translateY(calc(var(--stagger-column-offset, 48px) / 2));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stagger grid",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" }
      ],
      "default": "h3",
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all",
      "default": true,
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all",
      "visible_if": "{{ section.settings.show_view_all and section.settings.show_heading }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_offset",
      "label": "Column offset",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animate_on_scroll",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Stagger grid",
      "category": "Products"
    }
  ]
}
{% endschema %}
