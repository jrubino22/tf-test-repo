<script
  src="{{ 'editorial-split.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<editorial-split-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --editorial-split-image-height: {{ section.settings.image_height }};
  "
>
  <div class="editorial-split__grid{% if section.settings.reverse_layout %} editorial-split__grid--reversed{% endif %}">
    <div class="editorial-split__media-wrapper">
      <div class="editorial-split__media" ref="media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 768px) 55vw, 100vw',
              widths: '375,550,750,1000,1400',
              alt: section.settings.image_alt,
              class: 'editorial-split__img'
          }}
        {% else %}
          <img
            src="{{ 'editorial-split-image.svg' | asset_url }}"
            alt="{{ section.settings.image_alt }}"
            width="600"
            height="900"
            loading="lazy"
            class="editorial-split__img"
          >
        {% endif %}
      </div>
    </div>

    <div class="editorial-split__copy" ref="copy">
      {% if section.settings.heading != blank %}
        <h2 class="editorial-split__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <div class="editorial-split__body">{{ section.settings.body_text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
          class="editorial-split__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</editorial-split-section>

{% stylesheet %}
  editorial-split-section {
    display: block;
    position: relative;
  }

  .editorial-split__grid {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 0;
    align-items: center;
  }

  .editorial-split__grid--reversed {
    grid-template-columns: 45% 55%;
  }

  .editorial-split__grid--reversed .editorial-split__media-wrapper {
    order: 2;
  }

  .editorial-split__grid--reversed .editorial-split__copy {
    order: 1;
  }

  .editorial-split__media-wrapper {
    overflow: hidden;
    height: var(--editorial-split-image-height, 75svh);
    position: relative;
  }

  .editorial-split__media {
    height: 110%;
    will-change: transform;
  }

  .editorial-split__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-split__copy {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 1.5rem);
    padding: var(--padding-xl, 3rem);
    max-width: 32rem;
  }

  .editorial-split__grid:not(.editorial-split__grid--reversed) .editorial-split__copy {
    margin-inline-start: auto;
  }

  .editorial-split__grid--reversed .editorial-split__copy {
    margin-inline-end: auto;
  }

  /* Staggered reveal children */
  @media (prefers-reduced-motion: no-preference) {
    .editorial-split__copy > * {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s var(--ease-out-cubic, ease),
                  transform 0.6s var(--ease-out-cubic, ease);
    }

    .editorial-split__copy > *:nth-child(1) { transition-delay: 0ms; }
    .editorial-split__copy > *:nth-child(2) { transition-delay: 100ms; }
    .editorial-split__copy > *:nth-child(3) { transition-delay: 200ms; }
    .editorial-split__copy > *:nth-child(4) { transition-delay: 300ms; }

    .editorial-split__copy.is-visible > * {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-split__copy > * {
      opacity: 1;
      transform: none;
    }
  }

  .editorial-split__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.5vw, var(--font-size--4xl, 2.5rem));
    font-weight: var(--font-heading--weight, 700);
    line-height: var(--line-height--display-tight, 1.0);
    margin: 0;
  }

  .editorial-split__body {
    font-family: var(--font-body--family);
    font-size: var(--font-size--base, 1rem);
    line-height: var(--line-height--body-loose, 1.6);
    margin: 0;
  }

  .editorial-split__button {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: currentColor;
    border-bottom: 1px solid currentColor;
    padding-block-end: 0.25rem;
    width: fit-content;
    transition: opacity 0.2s ease;
  }

  .editorial-split__button:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 768px) {
    .editorial-split__grid,
    .editorial-split__grid--reversed {
      grid-template-columns: 1fr;
    }

    .editorial-split__grid--reversed .editorial-split__media-wrapper,
    .editorial-split__grid--reversed .editorial-split__copy {
      order: unset;
    }

    .editorial-split__media-wrapper {
      height: 60svh;
    }

    .editorial-split__media {
      height: 100%;
    }

    .editorial-split__copy {
      padding: var(--padding-lg, 2rem) var(--padding-md, 1.5rem);
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial split",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Editorial image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted With Intent"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Every piece in our collection is designed with purpose — blending modern aesthetics with enduring quality. We believe in creating products that stand the test of time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout",
      "default": false
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "50svh", "label": "Small" },
        { "value": "75svh", "label": "Medium" },
        { "value": "100svh", "label": "Large" }
      ],
      "default": "75svh"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Editorial split",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
