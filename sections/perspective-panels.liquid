<script
  src="{{ 'perspective-panels.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<perspective-panels-section
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --perspective-depth: {{ section.settings.perspective_depth }}px;
    --perspective-columns: {{ section.settings.columns_flat }};
  "
  data-fan-spread="{{ section.settings.fan_spread }}"
>
  <div
    class="perspective-panels__stage"
    ref="stage"
  >
    {% for block in section.blocks %}
      <div
        class="perspective-panels__panel"
        ref="panels[]"
        {{ block.shopify_attributes }}
      >
        <div class="perspective-panels__panel-media">
          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                widths: '300,400,600,800,900',
                alt: block.settings.image.alt
            }}
          {% else %}
            <div class="perspective-panels__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'perspective-panels__placeholder-svg' }}
            </div>
          {% endif %}
        </div>
        <div class="perspective-panels__panel-scrim"></div>
        <div class="perspective-panels__panel-content">
          {% if block.settings.heading != blank %}
            <h3 class="perspective-panels__panel-heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <p class="perspective-panels__panel-body">{{ block.settings.body }}</p>
          {% endif %}
          {% if block.settings.link_label != blank %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="perspective-panels__panel-link">
                {{ block.settings.link_label }}
              </a>
            {% else %}
              <span class="perspective-panels__panel-link">{{ block.settings.link_label }}</span>
            {% endif %}
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</perspective-panels-section>

{% stylesheet %}
  perspective-panels-section {
    display: block;
  }

  .perspective-panels__stage {
    perspective: var(--perspective-depth, 1000px);
    display: grid;
    grid-template-columns: repeat(var(--perspective-columns, 3), 1fr);
    gap: 1.5rem;
    transform-style: preserve-3d;
  }

  .perspective-panels__panel {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    will-change: transform;
    backface-visibility: hidden;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perspective-panels__panel:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .perspective-panels__panel-media {
    position: absolute;
    inset: 0;
  }

  .perspective-panels__panel-media img,
  .perspective-panels__panel-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .perspective-panels__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.06);
  }

  .perspective-panels__placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .perspective-panels__panel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.65) 0%,
      rgb(0 0 0 / 0.2) 40%,
      transparent 100%
    );
    pointer-events: none;
  }

  .perspective-panels__panel-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    color: #fff;
    gap: 0.5rem;
  }

  .perspective-panels__panel-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--xl);
    line-height: 1.15;
  }

  .perspective-panels__panel-body {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    line-height: 1.5;
    opacity: 0.85;
  }

  .perspective-panels__panel-link {
    display: inline-block;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    margin-block-start: 0.25rem;
  }

  a.perspective-panels__panel-link:hover {
    opacity: 0.8;
  }

  a.perspective-panels__panel-link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Expanded state */
  .perspective-panels__panel.is-expanded {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
    transform: none !important;
    z-index: 2;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .perspective-panels__panel {
      transform: none;
      will-change: auto;
      transition: none;
    }

    .perspective-panels__stage {
      perspective: none;
    }
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    .perspective-panels__stage {
      grid-template-columns: repeat(2, 1fr);
      perspective: none;
    }

    .perspective-panels__panel {
      transform: none !important;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .perspective-panels__stage {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .perspective-panels__panel {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Perspective panels",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Panel heading"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "perspective_depth",
      "label": "Perspective depth",
      "min": 400,
      "max": 1600,
      "step": 100,
      "default": 1000,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "fan_spread",
      "label": "Fan spread",
      "min": 10,
      "max": 45,
      "step": 5,
      "default": 25,
      "unit": "deg"
    },
    {
      "type": "range",
      "id": "columns_flat",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Perspective panels",
      "category": "Story",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "heading": "Summer Edit",
            "body": "Explore our curated selection of seasonal essentials.",
            "link_label": "Explore"
          }
        },
        {
          "type": "panel",
          "settings": {
            "heading": "Best Sellers",
            "body": "Discover the pieces our community loves most.",
            "link_label": "Explore"
          }
        },
        {
          "type": "panel",
          "settings": {
            "heading": "New In",
            "body": "The latest additions to our ever-evolving collection.",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
